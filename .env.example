# API Gateway base URL (no path). Async jobs:
#   POST /intelliframe/base
#   POST /intelliframe/export-pdf
#   GET  /intelliframe/jobs/{job_id}
NEXT_PUBLIC_API_BASE_URL=https://of6rpy6zah.execute-api.us-east-2.amazonaws.com

# Cognito user pool (federated Google Workspace OIDC)
NEXT_PUBLIC_AWS_REGION=us-east-2
NEXT_PUBLIC_USER_POOL_ID=us-east-2_XXXXXXXXX
NEXT_PUBLIC_USER_POOL_CLIENT_ID=yourAppClientId
NEXT_PUBLIC_COGNITO_DOMAIN=your-prefix.auth.us-east-2.amazoncognito.com
NEXT_PUBLIC_OIDC_PROVIDER=GoogleWorkspace
